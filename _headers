# Cache para imagens (1 ano)
/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable

# Cache para WebP (1 ano)
/*.webp
  Cache-Control: public, max-age=31536000, immutable

/images/**/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Cache para HTML (curto)
/index.html
  Cache-Control: public, max-age=3600

/bio.html
  Cache-Control: public, max-age=3600

/bio-page.html
  Cache-Control: public, max-age=3600
