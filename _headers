/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-src 'self'; base-uri 'self'; form-action 'self'

# Cache para imagens (1 ano)
/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable

# Cache para WebP (1 ano)
/*.webp
  Cache-Control: public, max-age=31536000, immutable

/images/**/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Cache para HTML (curto)
/index.html
  Cache-Control: public, max-age=3600

/bio.html
  Cache-Control: public, max-age=3600

/bio-page.html
  Cache-Control: public, max-age=3600
